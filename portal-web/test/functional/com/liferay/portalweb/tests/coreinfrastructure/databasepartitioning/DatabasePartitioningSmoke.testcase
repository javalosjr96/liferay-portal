@component-name = "portal-db-infrastructure"
definition {

	property custom.properties = "feature.flag.LPD-11342=true";
	property database.partition.enabled = "true";
	property database.types = "mysql";
	property test.liferay.virtual.instance = "false";
	property testray.main.component.name = "Database Partitioning";

	test CanNavigateToSitePortletAfterVisitingControlPanel {
		SignIn.signInTestSetup();

		task ("Go to Sites admin so the product menu toggle is visible") {
			ApplicationsMenu.gotoPortlet(
				category = "Sites",
				panel = "Control Panel",
				portlet = "Sites");
		}

		task ("Navigate to a site-scoped portlet via the product menu while still on the Control Panel page") {
			ProductMenu.gotoPortlet(
				category = "Site Builder",
				portlet = "Pages",
				site = "Guest");
		}
	}

}
