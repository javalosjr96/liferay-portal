apply plugin: "com.liferay.lang.merger"

dependencies {
	compileOnly group: "com.liferay.portal", name: "com.liferay.portal.kernel", version: "92.1.0"
}

mergeLang {
	setting("../document-library-web/src/main/resources/content") {
		transformKeys = [
			"second": "second",
			"seconds": "seconds",
			"x-second[time]": "x-second[time]"
		]

	}

	sourceDirs = ["../document-library-web/src/main/resources/content"]
}