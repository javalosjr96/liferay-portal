Bundle-Name: Liferay Batch Engine Service
Bundle-SymbolicName: com.liferay.batch.engine.service
Bundle-Version: 4.0.57
Import-Package:\
	!com.graphbuilder.*,\
	\
	!de.rototor.pdfbox.graphics2d.*,\
	\
	!org.apache.batik.dom.*,\
	!org.apache.batik.parser.*,\
	!org.apache.batik.svggen.*,\
	!org.apache.maven.*,\
	!org.apache.tools.ant.*,\
	\
	!org.bouncycastle.*,\
	\
	!org.w3c.dom.svg.*,\
	\
	com.github.*;resolution:=optional,\
	\
	com.microsoft.schemas.office.powerpoint.*;resolution:=optional,\
	com.microsoft.schemas.office.word.*;resolution:=optional,\
	\
	com.sun.*;resolution:=optional,\
	\
	net.sf.*;resolution:=optional,\
	\
	org.apache.batik.*;resolution:=optional,\
	org.apache.commons.math3.*;resolution:=optional,\
	org.apache.jcp.*;resolution:=optional,\
	\
	org.brotli.*;resolution:=optional,\
	\
	org.etsi.*;resolution:=optional,\
	\
	org.openxmlformats.schemas.*;resolution:=optional,\
	\
	org.tukaani.*;resolution:=optional,\
	\
	*
Liferay-Require-SchemaVersion: 4.6.2
Liferay-Service: true
-dsannotations-options: inherit