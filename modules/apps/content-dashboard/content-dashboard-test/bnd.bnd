Bundle-Name: Liferay Content Dashboard Test
Bundle-SymbolicName: com.liferay.content.dashboard.test
Bundle-Version: 1.0.0
Import-Package:\
	!com.github.luben.*,\
	\
	!com.graphbuilder.*,\
	\
	!com.microsoft.schemas.office.*,\
	\
	!com.sun.*,\
	\
	!com.zaxxer.sparsebits.*,\
	\
	!net.sf.*,\
	\
	!org.apache.batik.*,\
	!org.apache.commons.math3.*,\
	!org.apache.jcp.*,\
	!org.apache.tools.ant.*,\
	!org.apache.batik.parser.*,\
    !org.apache.batik.svggen.*,\
    !org.apache.maven.*,\
    !org.w3c.dom.svg.*,\
    !com.github.javaparser.*,\
    !de.rototor.pdfbox.graphics2d.*,\
	\
	!org.bouncycastle.*,\
	\
	!org.brotli.*,\
	\
	!org.etsi.*,\
	\
	!org.openxmlformats.*,\
	\
	!org.tukaani.*,\
	\
	*
-includeresource:\
	commons-collections4-[0-9.]*.jar;lib:=true,\
	commons-compress-[0-9.]*.jar;lib:=true,\
	commons-math3-[0-9.]*.jar;lib:=true,\
	poi-[0-9.]*.LIFERAY-PATCHED-[0-9.]*.jar;lib:=true,\
	poi-ooxml-[0-9.]*.LIFERAY-PATCHED-[0-9.]*.jar;lib:=true,\
	poi-ooxml-lite-[0-9.]*.LIFERAY-PATCHED-[0-9.]*.jar;lib:=true,\
	xmlbeans-[0-9.]*.LIFERAY-PATCHED-[0-9.]*.jar;lib:=true